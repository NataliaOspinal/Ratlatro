--- !u!114 &3490542597276844265
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6408965828556566286}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83ebdea839a9eb34eb80bab0aefb989a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoDeSala
  panelNarracion: {fileID: 5628348326559871396}
  textoNarrativa: {fileID: 2831892376093584309}
  imagenPersonajeUI: {fileID: 7044884719595079261}
  fuerzaSalto: 20
  duracionSalto: 0.3
  lineasDialogo:
  - texto: "R4T-001... Nosotros tambi\xE9n estamos rotos. Compartimos la misma sangre
      fluorescente."
    spritePersonaje: {fileID: 21300000, guid: 15a016ff4830aef4da443df704d89cb6, type: 3}
  - texto: "Has olvidado qui\xE9n eras antes del cieno. Yo lo veo todo. "
    spritePersonaje: {fileID: 21300000, guid: f841accd5ea7fe34b83727e8b958c6b0, type: 3}
  - texto: "Hay un eco tuyo m\xE1s adelante, cerca de los extractores. B\xFAscalo.
      Reconstruye tu mente antes de que te disuelvas por completo."
    spritePersonaje: {fileID: 21300000, guid: f841accd5ea7fe34b83727e8b958c6b0, type: 3}
  velocidadEscritura: 0.05
  esperaInicial: 0.5
