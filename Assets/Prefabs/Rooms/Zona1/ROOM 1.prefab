  m_Script: {fileID: 11500000, guid: b6a4eb308550b6f4f9d7c8a752293df0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicaInicial
  reproductorAudio: {fileID: 2364139623473513305}
  sfxTemblor: {fileID: 8300000, guid: 2cb19d534b82fb04f90311c309a0577a, type: 3}
  sfxRomper: {fileID: 8300000, guid: 29d526186ba38354cb10b2467af70400, type: 3}
  panelNubeNegra: {fileID: 8356074294336621520}
  textoNarrativa: {fileID: 4802234687592377662}
  lineasDialogo:
  - texto: "Hey, hola peque\xF1\xEDn"
    spritePersonaje: {fileID: 21300000, guid: 15a016ff4830aef4da443df704d89cb6, type: 3}
  - texto: "Espero que no te hayas hecho da\xF1o con esa ca\xEDda, llevas mucho tiempo
      encerrado en esa jaula, \xBFNo es cierto?"
    spritePersonaje: {fileID: 21300000, guid: 15a016ff4830aef4da443df704d89cb6, type: 3}
  - texto: "Trata de estirar tus peque\xF1as patitas, tenemos mucho que hacer"
    spritePersonaje: {fileID: 21300000, guid: de04a4531a39e854c8b9b532795de4dd, type: 3}
  - texto: "Prueba movi\xE9ndote (utiliza WASD) para ir a la siguiente habitaci\xF3n"
    spritePersonaje: {fileID: 21300000, guid: de04a4531a39e854c8b9b532795de4dd, type: 3}
  velocidadEscritura: 0.05
  imagenPersonajeUI: {fileID: 300726662389792982}
  fuerzaSalto: 30
  duracionSalto: 0.35
  mesaAnimator: {fileID: 1045444307163702565}
  mascaraCirculo: {fileID: 5580458108868490683}
  pantallaNegra: {fileID: 4147974348289981586}
