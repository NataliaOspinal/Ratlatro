--- !u!114 &6858127456547161018
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8505883134154823635}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83ebdea839a9eb34eb80bab0aefb989a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoDeSala
  fuenteAudio: {fileID: 6462850291406040232}
  sfxDialogoLinea: {fileID: 8300000, guid: 5b64827a6baa34149bec9317e90a4560, type: 3}
  panelNarracion: {fileID: 4529231251398194990}
  textoNarrativa: {fileID: 6308417404579736895}
  imagenPersonajeUI: {fileID: 1226266058397499607}
  fuerzaSalto: 20
  duracionSalto: 0.3
  lineasDialogo:
  - texto: "Nivel de acidez disminuyendo dr\xE1sticamente. Has logrado salir de la
      digesti\xF3n, R4T-001. "
    spritePersonaje: {fileID: 21300000, guid: 6738b99e7211c00488335c2cc97e5da5, type: 3}
  - texto: "Pero las texturas de las paredes han cambiado... hay baldosas esterilizadas,
      dispensadores de comida vac\xEDos, palancas y luces de est\xEDmulo."
    spritePersonaje: {fileID: 21300000, guid: 15a016ff4830aef4da443df704d89cb6, type: 3}
  - texto: "Hemos llegado al Laboratorio de Skinner. Tu biomasa no ser\xE1 suficiente
      aqu\xED; veamos qu\xE9 tan bien recuerdas tus viejos trucos de laboratorio."
    spritePersonaje: {fileID: 21300000, guid: f841accd5ea7fe34b83727e8b958c6b0, type: 3}
  velocidadEscritura: 0.05
  esperaInicial: 0.5
--- !u!1001 &971736362941870479
PrefabInstance:
  m_ObjectHideFlags: 0
