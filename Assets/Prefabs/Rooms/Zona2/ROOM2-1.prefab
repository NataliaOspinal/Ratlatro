      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[0].texto
      value: " R4T-001, detente. Esos extractores de aire giran a una velocidad letal;
        tu masa principal ser\xEDa triturada al instante."
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[1].texto
      value: "Sin embargo... esa tuber\xEDa estrecha parece intacta. Es el momento
        perfecto para fragmentarte. "
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[2].texto
      value: "Env\xEDa a tu clon a trav\xE9s del conducto, su volumen reducido le
        permitir\xE1 pasar sin problemas."
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
