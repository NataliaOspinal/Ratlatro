--- !u!1001 &4480417127996245584
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 856629393313047508}
    m_Modifications:
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: imagenRataUI
      value: 
      objectReference: {fileID: 2625543483670612857}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: necesitaPuertaAbierta
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: puertaRequisito.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: 'puertaRequisito.Array.data[0]'
      value: 
      objectReference: {fileID: 3086231743745326231}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: 'puertaRequisito.Array.data[1]'
      value: 
      objectReference: {fileID: 8431200358237300012}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[0].texto
      value: "\xBFHola? \xA1hola! los sensores de movimiento de mi capsula han captado
        un organismo vivo"
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[1].texto
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[2].texto
      value: "\xA1Oh! Hola peque\xF1\xEDn, no te hab\xEDa visto bien "
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[3].texto
      value: "Creo que quiz\xE1s estes algo confundida. Capaz no lo recuerdes pero
        tu nombre es R4T-001, en el pasado sol\xEDamos trabajar  juntos"
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[4].texto
      value: "Creo que a\xFAn no te has aclimatizado, y te ves m\xE1s confundida
        de lo normal "
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[5].texto
      value: "Perm\xEDteme que me presente, puedes llamarme Rodriguez, Doctor Rodriguez"
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[6].texto
      value: A partir de ahora vamos a trabajar juntos en las siguientes salas de
        pruebas, pura rutina, como en los viejos tiempos
      objectReference: {fileID: 0}
    - target: {fileID: 547714282067996350, guid: 1b5e27bda6eab944e9f77e6edf7dd372, type: 3}
      propertyPath: paginasDeDialogo.Array.data[0].expresionRata
