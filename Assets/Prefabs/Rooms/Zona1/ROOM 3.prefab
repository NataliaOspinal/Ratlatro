  m_Script: {fileID: 11500000, guid: 83ebdea839a9eb34eb80bab0aefb989a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoDeSala
  fuenteAudio: {fileID: 66397922827927025}
  sfxDialogoLinea: {fileID: 8300000, guid: 5b64827a6baa34149bec9317e90a4560, type: 3}
  panelNarracion: {fileID: 3935658284571236869}
  textoNarrativa: {fileID: 6902131177478619156}
  imagenPersonajeUI: {fileID: 1819975365204389372}
  fuerzaSalto: 20
  duracionSalto: 0.3
  lineasDialogo:
  - texto: "Necesitas ser escurridiza, y no le prestes mucha atenci\xF3n a ese pat\xE1n
      hologr\xE1fico"
    spritePersonaje: {fileID: 21300000, guid: 15a016ff4830aef4da443df704d89cb6, type: 3}
  - texto: "Debes escapar, y recordar qui\xE9n eres. Eres una alima\xF1a despu\xE9s
      de todo, deber\xEDas poder escabullirte f\xE1cilmente debajo."
    spritePersonaje: {fileID: 21300000, guid: de04a4531a39e854c8b9b532795de4dd, type: 3}
  velocidadEscritura: 0.05
  esperaInicial: 0.5
