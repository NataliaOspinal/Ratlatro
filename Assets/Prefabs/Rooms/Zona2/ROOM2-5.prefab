--- !u!114 &1040203796829198915
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6133423651340143209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83ebdea839a9eb34eb80bab0aefb989a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoDeSala
  fuenteAudio: {fileID: 6446398318922539750}
  sfxDialogoLinea: {fileID: 8300000, guid: 5b64827a6baa34149bec9317e90a4560, type: 3}
  panelNarracion: {fileID: 4463335372694214537}
  textoNarrativa: {fileID: 6100121540180692376}
  imagenPersonajeUI: {fileID: 1310387476201136240}
  fuerzaSalto: 20
  duracionSalto: 0.3
  lineasDialogo:
  - texto: "Alima\xF1a, d\xE9jame decirte que puedo observarte en todo lo que haces
      y tambi\xE9n puedo o\xEDr las conversaciones con lo que queda de la memoria
      de ese doctor. "
    spritePersonaje: {fileID: 21300000, guid: 15a016ff4830aef4da443df704d89cb6, type: 3}
  - texto: "Dejame decirte que oir a ese ser tan pat\xE9tico no es algo que yo har\xEDa
      y es un peque\xF1o regalo que te voy a dar rata de alcantarilla."
    spritePersonaje: {fileID: 21300000, guid: d13058d5451c08e4199cba2901316b78, type: 3}
  - texto: "Solo hazme caso si es que quieres salir de aqu\xED, pero si lo sigues
      a el, no creo que logres ver la luz del sol."
    spritePersonaje: {fileID: 21300000, guid: d13058d5451c08e4199cba2901316b78, type: 3}
  velocidadEscritura: 0.05
  esperaInicial: 0.5
